{
  "manifest_version": 3,
  "name": "Lunta",
  "version": "0.1.1",
  "description": "Save papers and their PDFs to your Lunta library, with the access your browser already has.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Save to Lunta", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://127.0.0.1:47480/*", "<all_urls>"],
  "web_accessible_resources": [{ "resources": ["icons/*.png"], "matches": ["http://*/*", "https://*/*"] }],
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" }
  ]
}
