{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lunta",
  "version": "0.1.0",
  "identifier": "com.cmlangseth.lunta.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Lunta",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "dragDropEnabled": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Reference manager: collect, read, highlight and cite papers",
    "longDescription": "Lunta is a reference manager. Collect papers by DOI, PMCID, arXiv id or link, read them in a reflowable reading view or as PDF, highlight and annotate, search everything and copy citations. The library lives in a folder you choose (Google Drive, Dropbox, OneDrive or local) and syncs with the Mac and iPhone apps.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" },
      "wix": { "language": "en-US" }
    },
    "linux": {
      "deb": { "depends": [] },
      "appimage": { "bundleMediaFramework": false }
    }
  }
}
