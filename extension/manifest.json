{
  "manifest_version": 3,
  "name": "Lunta",
  "version": "1.2.0",
  "description": "Save papers and their PDFs to Lunta with the access your browser already has, and cite them in Google Docs.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Save to Lunta", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "background": {
    "service_worker": "background.js",
    "scripts": ["gdocs/config.js", "gdocs/citations-common.js", "gdocs/docs-model.js", "gdocs/flow.js", "gdocs/background-gdocs.js", "background.js"]
  },
  "permissions": ["activeTab", "scripting", "identity", "storage"],
  "host_permissions": ["http://127.0.0.1:47480/*", "<all_urls>"],
  "web_accessible_resources": [{ "resources": ["icons/*.png"], "matches": ["http://*/*", "https://*/*"] }],
  "browser_specific_settings": {
    "gecko": { "id": "lunta@cmlangseth.margins", "strict_min_version": "128.0", "data_collection_permissions": { "required": ["none"] } }
  },
  "content_scripts": [
    { "matches": ["http://*/*", "https://*/*"], "js": ["content.js"], "run_at": "document_idle" },
    { "matches": ["https://docs.google.com/document/*"], "js": ["gdocs/citations-common.js", "gdocs/clipboard.js", "gdocs/panel.js"], "run_at": "document_idle" }
  ]
}
